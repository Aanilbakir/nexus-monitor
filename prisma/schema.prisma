generator client {
  provider = "prisma-client"
  output   = "../packages/database/src/generated"
}

datasource db {
  provider = "postgresql"
}

model Host {
  id           String   @id @db.Uuid
  hostname     String   @db.VarChar(255)
  platform     String   @db.VarChar(32)
  architecture String   @db.VarChar(32)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  agents       Agent[]
}

model Agent {
  id             String               @id @db.Uuid
  hostId         String               @db.Uuid
  version        String               @db.VarChar(32)
  credentialHash String               @db.Char(64)
  enrolledAt     DateTime             @default(now())
  lastSeenAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  host           Host                 @relation(fields: [hostId], references: [id], onDelete: Cascade)
  heartbeats     Heartbeat[]
  metricSamples  SystemMetricSample[]
  alertInstances AlertInstance[]

  @@index([hostId])
  @@index([lastSeenAt])
}

model SystemMetricSample {
  id                      BigInt   @id @default(autoincrement())
  agentId                 String   @db.Uuid
  collectedAt             DateTime
  receivedAt              DateTime @default(now())
  cpuPercent              Float
  memoryTotalBytes        BigInt
  memoryUsedBytes         BigInt
  diskTotalBytes          BigInt
  diskUsedBytes           BigInt
  diskFreeBytes           BigInt
  networkReceivedBytes    BigInt
  networkTransmittedBytes BigInt
  uptimeSeconds           BigInt
  agent                   Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, collectedAt])
  @@index([agentId, collectedAt(sort: Desc)])
  @@index([receivedAt])
}

model Heartbeat {
  id         BigInt   @id @default(autoincrement())
  agentId    String   @db.Uuid
  receivedAt DateTime @default(now())
  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, receivedAt(sort: Desc)])
}

model AlertRule {
  id              String          @id @db.Uuid
  name            String          @db.VarChar(255)
  metric          String          @db.VarChar(32)
  comparison      String          @db.VarChar(8)
  threshold       Float
  durationSeconds Int
  severity        String          @db.VarChar(16)
  enabled         Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  instances       AlertInstance[]
}

model AlertInstance {
  id             String            @id @db.Uuid
  ruleId         String            @db.Uuid
  agentId        String            @db.Uuid
  dedupeKey      String            @db.VarChar(255)
  state          String            @db.VarChar(16)
  openedAt       DateTime          @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  observedValue  Float
  // Rules with existing alert history cannot be deleted; disable the rule instead.
  rule           AlertRule         @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  agent          Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  transitions    AlertTransition[]

  // Partial unique index on (dedupeKey) WHERE state <> 'RESOLVED' lives in the migration;
  // Prisma DSL cannot express a filtered unique index.
  @@index([agentId, openedAt(sort: Desc)])
  @@index([ruleId])
}

model AlertTransition {
  id              BigInt        @id @default(autoincrement())
  alertInstanceId String        @db.Uuid
  fromState       String?       @db.VarChar(16)
  toState         String        @db.VarChar(16)
  occurredAt      DateTime      @default(now())
  instance        AlertInstance @relation(fields: [alertInstanceId], references: [id], onDelete: Cascade)

  @@index([alertInstanceId, occurredAt])
}
