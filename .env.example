# Local development only. Copy this file to .env and choose a private password.
POSTGRES_DB=nexus_monitor
POSTGRES_USER=nexus
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgresql://nexus:replace-with-a-local-password@127.0.0.1:5432/nexus_monitor?schema=public

API_HOST=127.0.0.1
API_PORT=3000
AGENT_ENROLLMENT_TOKEN=replace-with-a-random-enrollment-token

AGENT_VERSION=0.1.0
NEXUS_AGENT_STATE_PATH=./data/agent-state.json
NEXUS_API_URL=http://127.0.0.1:3000
